---
// =====================================================================
// /products 列表态 —— 仅在无 ?code= 时渲染(可按 ?category= 过滤)
// 分类 slug 与 MegaMenu 同源:分类法 products1
// 详情态(有 ?code=)仍由 index.astro 分发给三个详情组件,与本组件无关
// =====================================================================
import { getTerm } from "emdash";
import Base from "../../layouts/Base.astro";
import {
  listProducts,
  PRODUCT_TAXONOMY,
  type ProductListItem,
} from "../../utils/product-data";

interface Props {
  /** 分类 slug(来自 ?category=);为空表示全部产品 */
  category?: string;
}

const { category = "" } = Astro.props;

const [items, term] = await Promise.all([
  listProducts({ category }),
  category ? getTerm(PRODUCT_TAXONOMY, category) : Promise.resolve(null),
]);

const list: ProductListItem[] = items;
const heading = term?.label || (category ? category : "All Products");
const description = category
  ? `Products in ${heading}`
  : "All products";
---

<Base title={heading} description={description}>
  <section class="plist">
    <header class="plist-head">
      <span class="plist-eyebrow">{category ? "Category" : "All Products"}</span>
      <h1 class="plist-title">{heading}</h1>
      <p class="plist-count">
        {list.length}
        {list.length === 1 ? "product" : "products"}
      </p>
    </header>

    {
      list.length > 0 ? (
        <div class="plist-grid">
          {list.map((p) => (
            <a href={p.link} class="plist-card">
              <div class="plist-img">
                {p.image ? (
                  <img src={p.image} alt={p.title} loading="lazy" />
                ) : (
                  <span class="plist-ph">No image</span>
                )}
              </div>
              {p.code && <span class="plist-code">{p.code}</span>}
              <h2 class="plist-name">{p.title}</h2>
            </a>
          ))}
        </div>
      ) : (
        <p class="plist-empty">
          {category ? "No products in this category yet." : "No products yet."}
        </p>
      )
    }
  </section>
</Base>

<style>
  .plist {
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--spacing-12) var(--spacing-6);
  }

  .plist-head {
    margin-bottom: var(--spacing-12);
    padding-bottom: var(--spacing-8);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .plist-eyebrow {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--spacing-2);
  }

  .plist-title {
    font-size: var(--font-size-4xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--spacing-2);
  }

  .plist-count {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .plist-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-8);
  }

  .plist-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s;
  }

  .plist-card:hover {
    transform: translateY(-2px);
  }

  .plist-img {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .plist-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plist-ph {
    color: #9b9b9b;
    font-size: 0.8125rem;
  }

  .plist-code {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #6b6b6b;
    background: #f0f0f0;
    padding: 0.125rem 0.4rem;
    border-radius: 3px;
  }

  .plist-name {
    font-size: 1rem;
    font-weight: 600;
    color: #111;
    margin: 0.4rem 0 0;
    line-height: 1.3;
  }

  .plist-empty {
    text-align: center;
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    padding: var(--spacing-8) 0;
  }

  @media (max-width: 900px) {
    .plist-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .plist-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
