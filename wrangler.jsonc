{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vbags",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			// ★ 独立数据库:vbags-db（ID 已与 Cloudflare 账号中的实际库对齐）
			"database_name": "vbags-db","database_id": "aac0fd0a-2f88-456d-9a2e-dceaed66b53b",
		},
	],
	"kv_namespaces": [
		{
			// EmDash 1.0.1 分布式对象缓存（替代 1.0.1 中已移除的 cloudflareCache）
			"binding": "CACHE_KV",
			"id": "20406c5a5b5c49c7b00951b438ca8247",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
